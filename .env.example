NETEASE_EMAIL=yourname@163.com
# 网易 IMAP/SMTP 客户端授权码，不是网页登录密码
NETEASE_AUTH_CODE=
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
CONNECTOR_API_TOKEN=
MAIL_READ_ONLY=false
# MiB，正整数；整信含 MIME/Base64 开销，单附件按解码后的大小
MAIL_MAX_MESSAGE_MIB=200
MAIL_MAX_ATTACHMENT_MIB=200
# 部署到公网后改成你的 HTTPS 域名（不带路径）
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 163 / 126 / yeah / VIP 163 / VIP 126 / 188 自动匹配；其他域名默认网易企业邮箱
# 专用主机可覆盖默认值
# IMAP_HOST=imap.163.com
# SMTP_HOST=smtp.163.com
# IMAP_PORT=993
# SMTP_PORT=465

# 本机 DNS/连接失败时通过 Google/Cloudflare DoH 查询备用 IP（只查询服务器域名）
MAIL_DNS_FALLBACK=true
# 可填写从 whatsmydns.net 查询到的公网 IP；TLS 仍校验上方官方主机名
# IMAP_CONNECT_IP=
# SMTP_CONNECT_IP=
