NETEASE_EMAIL=yourname@163.com
# 网易 IMAP/SMTP 客户端授权码，不是网页登录密码
NETEASE_AUTH_CODE=
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
CONNECTOR_API_TOKEN=
MAIL_READ_ONLY=false
# 部署到公网后改成你的 HTTPS 域名（不带路径）
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 163.com / 126.com / yeah.net 自动选择服务器；企业/VIP 邮箱显式配置
